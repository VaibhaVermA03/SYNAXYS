# Frontend build-time variables (Vite). None of these are secrets; they are embedded in the public bundle.
# Error tracking is disabled unless VITE_SENTRY_DSN is set. Use the DSN of a Sentry *browser/React* project.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
# Optional release label shown in Sentry (e.g. the git commit SHA; on Vercel use VITE_APP_RELEASE=$VERCEL_GIT_COMMIT_SHA)
VITE_APP_RELEASE=
