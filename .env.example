# SYNAXYS backend configuration. Copy to backend/.env and edit. NEVER commit .env or real values.
# Backend secrets must never be placed in frontend (VITE_*) variables.

# ---- Core -------------------------------------------------------------------------------------
APP_ENV=development                               # development | test | production (production enforces the guards listed in SECURITY.md)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=dev-only-change-me
# SQLite for local dev. Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME (postgres:// and postgresql:// are accepted and normalised)
DATABASE_URL=sqlite:///./synaxys_dev.sqlite3
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000                 # used to display the webhook URL; production: the DIRECT backend URL
CORS_ORIGINS=http://localhost:5173                # comma separated; also used for the Origin check on unsafe requests
LOG_LEVEL=INFO

# ---- GitHub OAuth (sign-in) + GitHub App (repository access) ------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must be registered as the app's callback URL. Dev: the backend. Production: the FRONTEND domain (it proxies /api), see DEPLOYMENT.md
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
GITHUB_OAUTH_SCOPE=read:user                      # ignored by GitHub Apps; keep minimal for OAuth Apps
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Provide EITHER a path to the .pem (preferred) OR the PEM on one line with literal \n sequences.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=                            # Generate: python -c "import secrets; print(secrets.token_hex(32))"

# ---- OpenAI (reviews + embeddings) ----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536                         # MUST equal the Pinecone index dimension
OPENAI_TIMEOUT_SECONDS=60
# Explicit opt-in: labelled deterministic keyword matcher (NOT AI) when no OPENAI_API_KEY. Never used as a fallback for failures.
REVIEW_USE_MOCK_LLM=false

# ---- Pinecone (code search) -----------------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=synaxys-code                  # serverless index, metric=cosine, dimension=EMBEDDING_DIMENSIONS
VECTOR_BACKEND=pinecone                           # "memory" = process-local demo adapter with lexical embeddings (dev/tests only)

# ---- Secrets at rest -------------------------------------------------------------------------------
# Fernet key(s), comma separated: first encrypts, all decrypt (rotation). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Sessions and cookies -----------------------------------------------------------------------------
SESSION_TTL_HOURS=12
COOKIE_SECURE=false                               # must be true in production (HTTPS)
COOKIE_SAMESITE=lax                               # lax | strict | none
DEMO_LOGIN_ENABLED=false                          # developer/e2e helper (POST /auth/demo-login, no UI button); always ignored in production
TRUST_PROXY_HEADERS=false                         # true ONLY behind a trusted reverse proxy (client IP for rate limits)
MAX_REQUEST_BYTES=2000000
AUTH_RATE_LIMIT_PER_MINUTE=10
SEARCH_RATE_LIMIT_PER_MINUTE=30

# ---- Review engine limits --------------------------------------------------------------------------------
REVIEW_MAX_FILES=50
REVIEW_MAX_PATCH_BYTES=200000
REVIEW_MIN_CONFIDENCE=0.5
REVIEW_MAX_FINDINGS=30
REVIEW_BATCH_CHARS=24000
REVIEW_TOTAL_CHARS=120000
REVIEW_MAX_BATCHES=6

# ---- Indexing / code search ------------------------------------------------------------------------------------
INDEX_MAX_FILE_BYTES=200000
INDEX_MAX_FILES=3000
INDEX_CHUNK_CHARS=1500
INDEX_EMBED_BATCH=64
CONTEXT_RETRIEVAL_ENABLED=true
CONTEXT_MIN_SCORE=0.35

# ---- Background worker -------------------------------------------------------------------------------------------
WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=4
JOB_DEFAULT_TIMEOUT_SECONDS=600
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_HEARTBEAT_PATH=/tmp/synaxys_worker.heartbeat
WORKER_SHUTDOWN_GRACE_SECONDS=30

# ---------------------------------------------------------------- Phase 1: rate limiting (Redis)
# Empty = per-process in-memory limits (correct only with ONE API instance). Set for 2+ instances. redis:// or rediss:// (TLS).
REDIS_URL=
# What to do while Redis is unreachable: memory (per-process fallback, default) | closed (deny) | open (allow)
RATE_LIMIT_REDIS_FAILURE=memory
RATE_LIMIT_REDIS_TIMEOUT_SECONDS=0.25
RATE_LIMIT_REDIS_RETRY_SECONDS=15
RATE_LIMIT_KEY_PREFIX=synaxys:rl
# Per client IP, all API routes except health and the GitHub webhook
GLOBAL_RATE_LIMIT_PER_MINUTE=300
# Per authenticated user
USER_RATE_LIMIT_PER_MINUTE=240
# 0 = legacy (first X-Forwarded-For entry). N = N-th entry from the right. Read docs/PHASE1_OPERATIONS.md before changing.
TRUSTED_PROXY_HOPS=0

# ---------------------------------------------------------------- Phase 1: platform administrators
# Comma-separated NUMERIC GitHub user IDs (not logins), e.g. 12345,67890. Empty = nobody is an admin.
ADMIN_GITHUB_IDS=

# ---------------------------------------------------------------- Phase 1: Sentry (empty DSN = disabled)
SENTRY_DSN=
# Defaults to APP_ENV
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ---------------------------------------------------------------- Phase 1: automatic cleanup / retention (days)
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_MINUTES=60
CLEANUP_BATCH_SIZE=500
# Per rule per run; the remainder is deleted by the next run
CLEANUP_MAX_BATCHES=20
# After a session expired / was revoked
RETENTION_SESSIONS_DAYS=7
# Minimum 7 (also the window in which a replayed webhook delivery id is recognised)
RETENTION_WEBHOOK_DAYS=30
RETENTION_JOBS_DONE_DAYS=14
RETENTION_JOBS_FAILED_DAYS=60
# The newest indexing job of every repository is always kept
RETENTION_INDEXING_JOBS_DAYS=30
# 0 = keep forever
RETENTION_AUDIT_DAYS=365
RETENTION_SECURITY_AUDIT_DAYS=730
# Answered/expired workspace invitations
RETENTION_INVITATIONS_DAYS=30
# READ notifications / any notification
RETENTION_NOTIFICATIONS_DAYS=90
RETENTION_NOTIFICATIONS_MAX_DAYS=365

# ---------------------------------------------------------------- Phase 3: scalable partial, branch-aware indexing
# Files per persisted batch (the unit of progress and of retry) and total blob bytes per batch
INDEX_BATCH_FILES=25
INDEX_BATCH_BYTES=2000000
# Embedding budget of ONE job run; when reached the job stops as "partial" and is continued on request (OpenAI cost control)
INDEX_MAX_CHUNKS_PER_RUN=20000
# Extra indexed branches per repository besides the default branch (bounds Pinecone usage)
INDEX_MAX_BRANCHES=5
# GitHub tree requests when a repository's recursive tree is truncated (directory-by-directory listing)
INDEX_MAX_TREE_REQUESTS=400
# Time-slice continuations of one job
INDEX_MAX_CONTINUATIONS=200
# Honour the repository's root .gitignore
INDEX_RESPECT_GITIGNORE=true

# ---------------------------------------------------------------- Phase 4: account data export
# Hours until a generated data export expires (and is deleted by the cleanup job)
EXPORT_TTL_HOURS=24

