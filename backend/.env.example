# SYNAXYS backend configuration. Copy to backend/.env and edit. NEVER commit .env or real values.
# Backend secrets must never be placed in frontend (VITE_*) variables.

# ---- Core -------------------------------------------------------------------------------------
APP_ENV=development                               # development | test | production (production enforces the guards listed in SECURITY.md)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=dev-only-change-me
# SQLite for local dev. Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME (postgres:// and postgresql:// are accepted and normalised)
DATABASE_URL=sqlite:///./synaxys_dev.sqlite3
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000                 # used to display the webhook URL; production: the DIRECT backend URL
CORS_ORIGINS=http://localhost:5173                # comma separated; also used for the Origin check on unsafe requests
LOG_LEVEL=INFO

# ---- GitHub OAuth (sign-in) + GitHub App (repository access) ------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must be registered as the app's callback URL. Dev: the backend. Production: the FRONTEND domain (it proxies /api), see DEPLOYMENT.md
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
GITHUB_OAUTH_SCOPE=read:user                      # ignored by GitHub Apps; keep minimal for OAuth Apps
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Provide EITHER a path to the .pem (preferred) OR the PEM on one line with literal \n sequences.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=                            # Generate: python -c "import secrets; print(secrets.token_hex(32))"

# ---- OpenAI (reviews + embeddings) ----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536                         # MUST equal the Pinecone index dimension
OPENAI_TIMEOUT_SECONDS=60
# Explicit opt-in: labelled deterministic keyword matcher (NOT AI) when no OPENAI_API_KEY. Never used as a fallback for failures.
REVIEW_USE_MOCK_LLM=false

# ---- Pinecone (code search) -----------------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=synaxys-code                  # serverless index, metric=cosine, dimension=EMBEDDING_DIMENSIONS
VECTOR_BACKEND=pinecone                           # "memory" = process-local demo adapter with lexical embeddings (dev/tests only)

# ---- Secrets at rest -------------------------------------------------------------------------------
# Fernet key(s), comma separated: first encrypts, all decrypt (rotation). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Sessions and cookies -----------------------------------------------------------------------------
SESSION_TTL_HOURS=12
COOKIE_SECURE=false                               # must be true in production (HTTPS)
COOKIE_SAMESITE=lax                               # lax | strict | none
DEMO_LOGIN_ENABLED=false                          # developer/e2e helper (POST /auth/demo-login, no UI button); always ignored in production
TRUST_PROXY_HEADERS=false                         # true ONLY behind a trusted reverse proxy (client IP for rate limits)
MAX_REQUEST_BYTES=2000000
AUTH_RATE_LIMIT_PER_MINUTE=10
SEARCH_RATE_LIMIT_PER_MINUTE=30

# ---- Review engine limits --------------------------------------------------------------------------------
REVIEW_MAX_FILES=50
REVIEW_MAX_PATCH_BYTES=200000
REVIEW_MIN_CONFIDENCE=0.5
REVIEW_MAX_FINDINGS=30
REVIEW_BATCH_CHARS=24000
REVIEW_TOTAL_CHARS=120000
REVIEW_MAX_BATCHES=6

# ---- Indexing / code search ------------------------------------------------------------------------------------
INDEX_MAX_FILE_BYTES=200000
INDEX_MAX_FILES=3000
INDEX_CHUNK_CHARS=1500
INDEX_EMBED_BATCH=64
CONTEXT_RETRIEVAL_ENABLED=true
CONTEXT_MIN_SCORE=0.35

# ---- Background worker -------------------------------------------------------------------------------------------
WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=4
JOB_DEFAULT_TIMEOUT_SECONDS=600
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_HEARTBEAT_PATH=/tmp/synaxys_worker.heartbeat
WORKER_SHUTDOWN_GRACE_SECONDS=30
